#version 330 core
layout (location = 0) in vec3 position;
layout (location = 1) in vec3 aNormal;

out vec3 FragPos;
out vec3 Normal;

uniform mat4 model;         // obrót i skala kamery (w tym programie nieużywane)
uniform mat4 view;          // pozycja kamery
uniform mat4 projection;    // perspektywa

void main()
{
    gl_Position = projection * view * model * vec4(position, 1.0);  // P * V * M
    FragPos = vec3(model * vec4(position, 1.0));
    Normal = mat3(transpose(inverse(model))) * aNormal;     // transpozycja przez odwrotność macierzy modelu * aNormal - wektor normalny reaguje na zmiany zachodzące we Frame
    //Normal = aNormal;
}